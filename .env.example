# このファイルを .env にコピーして値を設定してください（.env は git 管理外）
#   cp .env.example .env

# BioGRID API キー（任意・非商用利用限定ライセンス）
# 未登録の場合は https://webservice.thebiogrid.org/ で無料登録
BIOGRID_API_KEY=

# EPA CCTE (CTX Bioactivity/ToxCast) API キー（任意・商用利用可）
# ccte_api@epa.gov にメールで申請すると発行される（即時発行ではない）
CCTE_API_KEY=

# Ollama の接続先（別サーバーで動かす場合のみ指定）
# OLLAMA_HOST=http://localhost:11434
